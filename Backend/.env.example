PORT=8000
# MongoDB Atlas connection string (replace placeholders)
# Example:
# mongodb+srv://<username>:<password>@<cluster-url>/chatapp?retryWrites=true&w=majority
MONGODB_URI=
SECRET_KEY=changeme
NODE_ENV=dev

GROQ_API_KEY=

# AWS S3 (private bucket)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Optional for S3-compatible providers (e.g. MinIO)
# S3_ENDPOINT=

# TTL for signed GET URLs returned to clients
S3_SIGNED_GET_TTL_SECONDS=3600

# TTL for pre-signed PUT upload URLs
S3_UPLOAD_PRESIGNED_TTL_SECONDS=900
